{
  "name": "spidal",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-trixie",
  "features": {
    "ghcr.io/devcontainers-extra/features/direnv:1": {},
    "ghcr.io/devcontainers-extra/features/bun:1": {},
    "ghcr.io/devcontainer-community/devcontainer-features/astral.sh-uv:1": {}
  },
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/.profile,target=/home/vscode/.profile,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/vscode/.claude,type=bind"
  ],
  "postCreateCommand": "make devcontainer",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh (login)",
        "terminal.integrated.profiles.linux": {
          "zsh (login)": {
            "path": "zsh",
            "args": ["-l"]
          }
        }
      }
    }
  }
}
